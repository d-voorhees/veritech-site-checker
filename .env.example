# ---------------------------------------------------------------------------
# Veritech Site Checker — environment configuration
# Copy to .env for local development. Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- Product identity -------------------------------------------------------
APP_ENV=development
APP_DOMAIN=localhost
APP_URL=http://localhost:3000
MARKETING_SITE_URL=https://veritechdiligence.com
NEXT_PUBLIC_PRODUCT_NAME=Veritech Site Checker
PARENT_BRAND=Veritech Diligence
REPORT_NAME=Technical Acquisition Brief

# Public URL the browser should call the API through. In production Next.js
# proxies /api/* and /health to the API process running alongside it in the
# same Fly Machine (see next.config.mjs + scripts/entrypoint.sh), so this
# only matters for local dev / hitting the API directly.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Google Tag Manager container ID. Not a secret (it's visible in every page's
# HTML source) — kept in env so it isn't hardcoded into the public repo and
# can differ per environment. Unset means no GTM script is injected.
NEXT_PUBLIC_GTM_ID=

# --- Postgres ------------------------------------------------------------------
# Local dev: native Postgres, localhost only — never exposed publicly.
# Create the role/db yourself (see README.md's "Local setup").
DATABASE_URL=postgresql+psycopg://veritech_scan:change-me@127.0.0.1:5432/veritech_scan

# --- Auth ----------------------------------------------------------------------
JWT_SECRET=replace-with-secure-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me

# --- Scan safety limits ---------------------------------------------------------
SCAN_MAX_TOTAL_MINUTES=10
SCAN_DEFAULT_REQUEST_DELAY_SECONDS=1.5
SCAN_MAX_PAGES=50
SCAN_PAGE_TIMEOUT_SECONDS=15
SCAN_CREATE_RATE_LIMIT_PER_HOUR=10
SCAN_CREATE_RATE_LIMIT_PER_DAY=3

# --- Optional external providers -------------------------------------------------
GOOGLE_PAGESPEED_API_KEY=
SENTRY_DSN=

# --- Magic-link auth + Brevo/MailerLite (free-launch self-serve signup) --------
# Passwordless sign-in reuses JWT_SECRET/APP_URL above for the session
# cookie and the verify link — see app/config.py for why no separate
# session secret or base-URL var was added.
MAGIC_LINK_TOKEN_EXPIRES_MINUTES=20
MAGIC_LINK_REQUEST_RATE_LIMIT_PER_HOUR=5

# First Brevo integration in this codebase (see docs on the free-launch
# signup build) — a Brevo API key, a verified sender, and (once Danielle
# creates it in the Brevo dashboard) a transactional template ID for the
# magic-link email. Sends fall back to plain inline HTML until the template
# ID is set.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Veritech Site Checker
BREVO_MAGIC_LINK_TEMPLATE_ID=

MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=196262875934754744

# Slack Incoming Webhook (https://api.slack.com/messaging/webhooks) for
# scan-started / scan-completed notifications, and the inbox that gets a
# copy of every completed scan's results via Brevo. Both optional — unset
# means no notification is sent, never a broken scan.
SLACK_WEBHOOK_URL=
RESULTS_NOTIFICATION_EMAIL=

# --- Artifact storage ------------------------------------------------------------
# "local" writes to a plain filesystem path. "s3" is a documented future
# extension point (see packages/shared and apps/api/app/services/artifact_storage.py).
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_LOCAL_PATH=./artifacts

# --- Playwright ------------------------------------------------------------------
# Leave unset for local dev to use Playwright's default cache
# (~/.cache/ms-playwright). The Fly production image sets this explicitly
# in the Dockerfile.
PLAYWRIGHT_BROWSERS_PATH=

# ---------------------------------------------------------------------------
# --- Fly.io deployment (production only — leave unset for local dev) -------
# ---------------------------------------------------------------------------
# See docs/fly-deployment.md. Set these with `flyctl secrets set` on the
# deployed app — never put real values in a committed .env file.

# The Fly app name (both `flyctl` commands and the app's own Fly Machines
# API calls to create scan-runner Machines use this).
FLY_APP_NAME=

# A Fly API token with permission to create/manage Machines on FLY_APP_NAME.
# Server-side only — never exposed to the browser, never NEXT_PUBLIC_*.
FLY_API_TOKEN=

# Region new scan-runner Machines are created in (should match the app's
# primary region so the runner is close to the database).
FLY_PRIMARY_REGION=iad

# Set automatically when you attach Fly Postgres/Managed Postgres
# (`fly postgres attach`). Used only if DATABASE_URL isn't set — see
# app/config.py's `resolved_database_url`.
FLY_DATABASE_URL=
